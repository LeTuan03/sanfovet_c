generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                 BigInt   @id @default(autoincrement())
  slug               String   @unique
  name               String
  categoryId         BigInt
  image              String   @default("")
  images             String[] @default([])
  featured           Boolean  @default(false)
  registrationNumber String?
  description        String?
  specifications     Json     @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("products")
}

model Category {
  id   BigInt @id @default(autoincrement())
  name String
  slug String @unique

  @@map("categories")
}

model Article {
  id          BigInt   @id @default(autoincrement())
  slug        String   @unique
  title       String
  category    String
  animalTag   String?
  publishDate String
  thumbnail   String   @default("")
  excerpt     String   @default("")
  content     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("articles")
}

model Job {
  id          BigInt   @id @default(autoincrement())
  slug        String   @unique
  title       String
  location    String
  date        String
  description String   @default("")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("jobs")
}

model Banner {
  id     BigInt  @id @default(autoincrement())
  image  String  @default("")
  title  String
  link   String  @default("")
  status Boolean @default(true)
  order  Int     @default(0)

  @@map("banners")
}

model NavMenu {
  id       BigInt  @id @default(autoincrement())
  name     String
  link     String
  parent   BigInt?
  position String  @default("header")
  order    Int     @default(0)
  status   Boolean @default(true)
  hasMega  Boolean @default(false)
  isButton Boolean @default(false)

  @@map("nav_menus")
}

model Setting {
  id    BigInt @id @default(1)
  data  Json   @default("{}")

  @@map("settings")
}

model AnimalTag {
  id          BigInt @id @default(autoincrement())
  name        String
  slug        String @unique
  icon        String @default("")
  description String @default("")

  @@map("animal_tags")
}

model MediaImage {
  id     BigInt @id @default(autoincrement())
  url    String
  title  String
  order  Int    @default(0)
  status String @default("active")

  @@map("media_images")
}

model MediaVideo {
  id        BigInt @id @default(autoincrement())
  url       String
  title     String
  thumbnail String @default("")
  order     Int    @default(0)
  status    String @default("active")

  @@map("media_videos")
}

model Catalogue {
  id        BigInt   @id @default(autoincrement())
  title     String
  size      String   @default("")
  type      String   @default("PDF")
  link      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("catalogues")
}
